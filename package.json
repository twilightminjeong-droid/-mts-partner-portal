{
  "name": "partner-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:start": "C:/pgsql/bin/pg_ctl -D C:/pgsql/data -l C:/pgsql/postgres.log start",
    "db:stop": "C:/pgsql/bin/pg_ctl -D C:/pgsql/data stop"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^5.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
